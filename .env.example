# ===== 服务配置 =====
PORT=3000
NODE_ENV=production
# 信任的反向代理层数；按实际代理链设置，并确保代理覆盖客户端提交的转发头。
TRUST_PROXY_HOPS=1

# ===== 开发管理员旁路（危险！仅本地开发用） =====
# 设为 1 时，非生产环境下所有未登录请求会自动获得管理员权限。
# 生产环境永不生效，但也绝对不要在任何公网可达的部署里设置它。
# DEV_ADMIN_BYPASS=1

# ===== 文件存储 =====
DOWNLOAD_DIR=./downloads
DB_PATH=./data/stats.db
MAX_FILE_SIZE=157286400

# ===== GitHub Releases 自动同步 =====
# Token 只从环境变量读取，不通过管理 API 保存或返回
# GITHUB_TOKEN=your_github_read_token
# GITHUB_REPOSITORY=owner/repository
# MDT Android 工作流发布 APK 的仓库；配置后会自动加入下载同步来源，例如 mdtbbs/download-site
# MINDUSTRY_ANDROID_RELEASE_REPOSITORY=mdtbbs/download-site
RELEASE_SYNC_ENABLED=true
RELEASE_SYNC_INTERVAL_MS=3600000
RELEASE_SYNC_REQUEST_TIMEOUT_MS=30000

# ===== 本地管理员（论坛未上线时的临时方案） =====
# 设置后登录页将显示账号密码表单，论坛上线后请删除这两个变量
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=use_a_unique_password_of_at_least_16_characters

# ===== OAuth 2.0（MindAuth） =====
OAUTH_AUTHORIZE_URL=https://auth.mdtbbs.cn/api/authorize
OAUTH_TOKEN_URL=https://auth.mdtbbs.cn/api/token
OAUTH_USERINFO_URL=https://auth.mdtbbs.cn/api/userinfo
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_CALLBACK_URL=https://file.mdtbbs.cn/auth/callback

# ===== OAuth 后台邮箱白名单 =====
# 启用 OAuth 登录时必填：只有这些邮箱可访问管理后台，多个邮箱用英文逗号分隔
# ADMIN_ALLOWED_EMAILS=admin@your-real-domain.tld,ops@your-real-domain.tld

# ===== Session =====
SESSION_SECRET=change_me_to_a_random_secret
SESSION_MAX_AGE=86400000

# ===== 上传白名单 =====
ALLOWED_EXTENSIONS=.zip,.iso,.pdf,.txt,.png,.jpg,.jpeg,.gz,.tar,.7z,.doc,.docx,.xlsx,.md,.jar,.apk

# ===== 日志 =====
LOG_LEVEL=info
