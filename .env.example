# ===== 服务配置 =====
PORT=3000
NODE_ENV=production

# ===== 开发管理员旁路（危险！仅本地开发用） =====
# 设为 1 时，非生产环境下所有未登录请求会自动获得管理员权限。
# 生产环境永不生效，但也绝对不要在任何公网可达的部署里设置它。
# DEV_ADMIN_BYPASS=1

# 下载 CDN 域名；留空则生成相对 /d/... 链接
DOWNLOAD_BASE_URL=https://d.file.mdtbbs.cn

# ===== 文件存储 =====
DOWNLOAD_DIR=./downloads
DB_PATH=./data/stats.db
MAX_FILE_SIZE=157286400

# ===== GitHub Releases 自动同步 =====
# Token 只从环境变量读取，不通过管理 API 保存或返回
GITHUB_TOKEN=your_github_read_token
GITHUB_REPOSITORY=owner/repository
RELEASE_SYNC_ENABLED=false
RELEASE_SYNC_INTERVAL_MS=3600000
RELEASE_SYNC_REQUEST_TIMEOUT_MS=30000

# ===== 本地管理员（论坛未上线时的临时方案） =====
# 设置后登录页将显示账号密码表单，论坛上线后请删除这两个变量
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# ===== OAuth 2.0（MindAuth） =====
OAUTH_AUTHORIZE_URL=https://auth.mdtbbs.cn/api/authorize
OAUTH_TOKEN_URL=https://auth.mdtbbs.cn/api/token
OAUTH_USERINFO_URL=https://auth.mdtbbs.cn/api/userinfo
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_CALLBACK_URL=https://file.mdtbbs.cn/auth/callback

# ===== 后台邮箱白名单（OAuth，可选） =====
# 配置后，只有这些邮箱可访问管理后台，多个邮箱用英文逗号分隔
# 不配置则保持兼容：任意已登录 OAuth 用户都可访问后台
ADMIN_ALLOWED_EMAILS=admin@example.com,ops@example.com
# Required in production: only these OAuth email addresses may access admin routes.

# ===== Session =====
SESSION_SECRET=change_me_to_a_random_secret
SESSION_MAX_AGE=86400000

# ===== 上传白名单 =====
ALLOWED_EXTENSIONS=.zip,.iso,.pdf,.txt,.png,.jpg,.jpeg,.gz,.tar,.7z,.doc,.docx,.xlsx,.md,.jar

# ===== 日志 =====
LOG_LEVEL=info
