<!DOCTYPE html>
<html lang="zh-CN"<% if (currentTheme === 'terminal') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= siteInfo.site_description %>">
  <meta name="app-version" content="<%= appVersion %>">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <% if (currentTheme === 'terminal') { %>
  <script nonce="<%= cspNonce %>">
    (function(){
      var t = localStorage.getItem('theme');
      if (t !== 'light') document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>
  <% } else { %>
  <script nonce="<%= cspNonce %>">
    (function(){
      var t = localStorage.getItem('theme');
      if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>
  <% } %>
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/clean-blue-tokens.css">
  <link rel="stylesheet" href="/css/clean-blue-base.css">
  <link rel="stylesheet" href="/css/themes/<%= currentTheme %>.css">
  <script src="/js/file-actions.js" defer></script>
</head>
<body>
