<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="<%= typeof description === 'string' ? description : siteInfo.site_description %>">
  <% if (typeof canonicalUrl === 'string') { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= typeof description === 'string' ? description : siteInfo.site_description %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="MDT File">
  <% } %>
  <meta name="app-version" content="<%= appVersion %>">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script nonce="<%= cspNonce %>">
    (function(){
      var t = localStorage.getItem('theme');
      if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/clean-blue-tokens.css">
  <link rel="stylesheet" href="/css/clean-blue-base.css">
  <link rel="stylesheet" href="/css/mdtbbs-layout.css">
  <link rel="stylesheet" href="/css/mdtbbs-components.css">
  <link rel="stylesheet" href="/css/mdtbbs-status.css">
  <script src="/js/mdt-shell.js" defer></script>
  <script src="/js/file-actions.js" defer></script>
  <% (typeof pageScripts !== 'undefined' && Array.isArray(pageScripts) ? pageScripts : []).forEach(function (src) { %><script src="<%= src %>" defer></script><% }); %>
</head>
<body class="mdt-shell">
