<% const banners = (typeof globalNotices === 'object' && globalNotices ? globalNotices : []).filter(function (notice) { return notice.scope === 'global'; }).slice(0, 2); %>
<div class="mdt-banner-region" role="region" aria-label="站内公告">
  <% banners.forEach(function (notice) { %>
    <div class="mdt-banner" data-type="<%= notice.type %>" data-notice-id="<%= notice.id %>"<%= notice.dismissible ? ' data-dismissible="1"' : '' %>>
      <span class="mdt-banner-icon" aria-hidden="true"><%= notice.type === 'critical' ? '!' : notice.type === 'warning' || notice.type === 'maintenance' ? '△' : 'i' %></span>
      <span class="mdt-banner-body">
        <strong><%= notice.title %></strong><% if (notice.content) { %> — <%= notice.content %><% } %>
        <a href="<%= notice.action_url && notice.action_label ? notice.action_url : ('/notices/' + notice.id) %>"><%= notice.action_url && notice.action_label ? notice.action_label : '查看详情' %></a>
      </span>
      <% if (notice.dismissible) { %><button type="button" class="mdt-banner-close" data-dismiss-notice="<%= notice.id %>" aria-label="关闭公告">×</button><% } %>
    </div>
  <% }); %>
</div>
