<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/themes/editorial.css">
</head>
<body>

<div style="display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 40px;">
  <div style="text-align: center; max-width: 400px;">
    <p class="category-label" style="margin-bottom: 12px;">ERROR</p>
    <hr class="rule-thick" style="margin-bottom: 24px; width: 60px; margin-left: auto; margin-right: auto;">
    <h2 class="error-title"><%= title %></h2>
    <p class="muted" style="font-size: 0.875rem; margin-top: 12px; line-height: 1.6;"><%= message %></p>
    <a href="/" class="back-link" style="display: inline-block; margin-top: 32px; font-size: 0.8rem;">← 返回首页</a>
  </div>
</div>

</body>
</html>
