<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="page-wrap">
  <header class="ed-header">
    <div class="ed-header-inner">
      <div class="ed-site-name"><%= siteInfo.site_name %></div>
      <div class="ed-stats">
        <strong><%= stats.file_count %></strong> 个文件 ·
        <strong><%= formatNumber(stats.total_downloads) %></strong> 次下载 ·
        <strong><%= formatFileSize(stats.total_size) %></strong>
      </div>
    </div>
  </header>

  <div class="ed-layout">
    <aside class="ed-sidebar">
      <a href="/" class="ed-nav-item"><span>首页</span></a>
      <% if (breadcrumbs.length > 0) { %>
        <% breadcrumbs.forEach(function(crumb) { %>
          <a href="<%= buildCategoryHref(crumb.path) %>" class="ed-nav-item">
            <span><%= crumb.name %></span>
          </a>
        <% }); %>
      <% } %>
    </aside>

    <main class="ed-main">
      <% if (parentPath) { %>
        <a href="<%= buildCategoryHref(parentPath) %>" class="ed-nav-item" style="margin-bottom: 1rem; display: inline-block;">← 返回上一级</a>
      <% } %>

      <h1 class="ed-page-title"><%= currentPath === 'root' ? '根目录' : currentPath %></h1>

      <% if (directories.length > 0) { %>
        <div class="ed-folders">
          <% directories.forEach(function(dir) { %>
            <a href="<%= buildCategoryHref(dir.path) %>" class="ed-folder-link">
              <span class="ed-folder-icon" aria-hidden="true"></span>
              <span><%= dir.name %></span>
              <% if (dir.isEmpty) { %><span class="ed-folder-empty">(空)</span><% } %>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (isEmpty) { %>
        <div class="ed-empty">此目录为空</div>
      <% } else if (files.length === 0) { %>
        <div class="ed-empty">暂无文件</div>
      <% } else { %>
        <% files.forEach(function(file) { %>
          <div class="ed-file-entry">
            <a href="<%= buildFilePageUrl(file.file_path) %>" class="ed-file-name" style="color: var(--primary);"><%= file.file_name %></a>
            <% if (file.description) { %>
              <div class="ed-file-desc"><%= file.description %></div>
            <% } %>
            <div class="ed-file-meta">
              <%= formatFileSize(file.file_size) %>
              <span> · </span>
              <%= formatNumber(file.download_count) %> 次下载
              <% if (file.last_download_at) { %>
                <span> · </span>最后下载 <%= formatDate(file.last_download_at) %>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </main>
  </div>
</div>
<%- include('../../partials/footer') %>
