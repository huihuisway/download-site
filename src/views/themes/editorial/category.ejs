<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="page-wrap">
  <header class="ed-header">
    <div class="ed-header-inner">
      <div class="ed-site-name"><%= siteInfo.site_name %></div>
      <div class="ed-stats">
        <strong><%= stats.file_count %></strong> 个文件 ·
        <strong><%= formatNumber(stats.total_downloads) %></strong> 次下载 ·
        <strong><%= formatFileSize(stats.total_size) %></strong>
      </div>
    </div>
  </header>

  <div class="ed-layout">
    <aside class="ed-sidebar">
      <a href="/" class="ed-nav-item"><span>全部文件</span></a>
      <% allCategories.forEach(function(cat) { %>
        <a href="/category/<%= cat %>" class="ed-nav-item<%= cat === category ? ' active' : '' %>">
          <span><%= cat %></span>
          <span class="ed-nav-count"><%= categoryCounts[cat] || 0 %></span>
        </a>
      <% }); %>
    </aside>

    <main class="ed-main">
      <h1 class="ed-page-title"><%= category %></h1>
      <% if (files.length === 0) { %>
        <div class="ed-empty">暂无文件</div>
      <% } else { %>
        <% files.forEach(function(file) { %>
          <div class="ed-file-entry">
            <a href="/download/<%= file.id %>" class="ed-file-name" style="color: var(--primary);"><%= file.file_name %></a>
            <% if (file.description) { %>
              <div class="ed-file-desc"><%= file.description %></div>
            <% } %>
            <div class="ed-file-meta">
              <%= formatFileSize(file.file_size) %>
              <span> · </span>
              <%= formatNumber(file.download_count) %> 次下载
              <% if (file.last_download_at) { %>
                <span> · </span>最后下载 <%= formatDate(file.last_download_at) %>
              <% } %>
              <% if (file.sha256) { %>
                <span> · </span>
                <span class="ed-file-sha"><%= file.sha256.substring(0, 16) %></span>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </main>
  </div>
</div>
<%- include('../../partials/footer') %>
