<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="page-wrap">
  <header class="ed-header">
    <div class="ed-header-inner">
      <div>
        <div class="ed-site-name"><%= siteInfo.site_name %></div>
        <div class="ed-site-desc"><%= siteInfo.site_description %></div>
      </div>
      <div class="ed-stats">
        <span><strong><%= totalFiles %></strong> 个文件</span>
        <span><strong><%= formatNumber(totalDownloads) %></strong> 次下载</span>
      </div>
    </div>
  </header>

  <div class="ed-layout">
    <aside class="ed-sidebar">
      <a href="/" class="ed-nav-item<%= !category ? ' active' : '' %>">
        <span>全部文件</span>
        <span class="ed-nav-count"><%= totalFiles %></span>
      </a>
      <% categories.forEach(function(cat) { %>
        <a href="/category/<%= cat %>" class="ed-nav-item">
          <span><%= cat %></span>
          <span class="ed-nav-count"><%= filesByCategory[cat] ? filesByCategory[cat].length : 0 %></span>
        </a>
      <% }); %>
    </aside>

    <main class="ed-main">
      <h1 class="ed-page-title">全部文件</h1>
      <% if (categories.length === 0) { %>
        <div class="ed-empty">暂无文件。管理员可通过后台上传。</div>
      <% } else { %>
        <% categories.forEach(function(cat) { %>
          <h2 class="ed-section-title"><%= cat %></h2>
          <% var files = filesByCategory[cat] || []; %>
          <% if (files.length === 0) { %>
            <div class="ed-empty">此分类暂无文件</div>
          <% } else { %>
            <% files.forEach(function(file) { %>
              <div class="ed-file-entry">
                <div class="ed-file-name"><%= file.file_name %></div>
                <% if (file.description) { %>
                  <div class="ed-file-desc"><%= file.description %></div>
                <% } %>
                <div class="ed-file-meta">
                  <%= formatFileSize(file.file_size) %>
                  <span> · </span>
                  <%= formatNumber(file.download_count) %> 次下载
                  <% if (file.sha256) { %>
                    <span> · </span>
                    <span class="ed-file-sha"><%= file.sha256.substring(0, 16) %></span>
                  <% } %>
                </div>
              </div>
            <% }); %>
          <% } %>
        <% }); %>
      <% } %>
    </main>
  </div>
</div>
<%- include('../../partials/footer') %>
