<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/themes/terminal.css">
</head>
<body>

  <header class="term-header">
    <div class="term-header-inner">
      <span class="term-logo">
        <span class="prompt">$</span> ls <span class="path">~/<%= siteInfo.site_name %>/<%= category %></span>
      </span>
      <span class="term-stats"><%= stats.file_count || 0 %> files · <%= formatFileSize(stats.total_size || 0) %></span>
    </div>
  </header>

  <div class="term-layout">
    <aside class="term-sidebar">
      <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 12px;"># navigation</div>
      <a href="/" class="term-nav-item">all</a>
      <% for (const cat of allCategories) { %>
        <a href="/category/<%= encodeURIComponent(cat) %>" class="term-nav-item<%= cat === category ? ' active' : '' %>"><%= cat %><span class="term-nav-count">(<%= categoryCounts[cat] || 0 %>)</span></a>
      <% } %>
      <div style="margin-top: 24px;">
        <a href="/" class="term-link" style="font-size: 11px;">$ cd ..</a>
      </div>
    </aside>

    <main class="term-main">
      <div class="term-section-header" style="margin-bottom: 12px;">
        <span style="color: var(--text-dim);">// </span><%= category %>
        <span style="color: var(--text-dim);"> — </span>
        <span style="color: var(--green);"><%= formatFileSize(stats.total_size || 0) %></span>
        <span style="color: var(--text-dim);"> · </span>
        <span style="color: var(--yellow);"><%= formatNumber(stats.total_downloads || 0) %> downloads</span>
      </div>

      <% if (files.length === 0) { %>
        <div class="term-empty">no files in this directory.</div>
      <% } else { %>
        <% for (const file of files) { %>
          <a href="/download/<%= file.id %>" class="term-file">
            <div class="term-file-name"><%= file.file_name %></div>
            <% if (file.description) { %>
              <div class="term-file-desc"><%= file.description %></div>
            <% } %>
            <div class="term-file-meta">
              <span class="size"><%= formatFileSize(file.file_size) %></span>
              <span class="term-sep">|</span>
              <span class="count"><%= formatNumber(file.download_count) %> dl</span>
              <% if (file.sha256) { %>
                <span class="term-sep">|</span>
                <span style="color: var(--text-dim); font-size: 10px;"><%= file.sha256.substring(0, 16) %></span>
              <% } %>
            </div>
          </a>
        <% } %>
      <% } %>

      <div class="term-status" style="margin-top: 24px;">
        <span class="ok">●</span> ready
      </div>
    </main>
  </div>

  <footer class="term-footer">
    <%= siteInfo.footer_text %><
  </footer>

</body>
</html>
