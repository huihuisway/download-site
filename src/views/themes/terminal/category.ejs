<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="page-wrap">
  <header class="term-header">
    <div class="term-header-inner">
      <div class="term-logo"><span class="prompt">$</span> <span class="path">~/downloads/<%= category %></span></div>
      <div class="term-stats"><%= stats.file_count %> files · <%= formatFileSize(stats.total_size) %></div>
    </div>
  </header>

  <div class="term-layout">
    <aside class="term-sidebar">
      <a href="/" class="term-nav-item">$ cd ..</a>
      <a href="/" class="term-nav-item">all</a>
      <% allCategories.forEach(function(cat) { %>
        <a href="/category/<%= cat %>" class="term-nav-item<%= cat === category ? ' active' : '' %>"><%= cat %> <span class="term-nav-count">(<%= categoryCounts[cat] || 0 %>)</span></a>
      <% }); %>
    </aside>

    <main class="term-main">
      <% if (files.length === 0) { %>
        <div class="term-empty">// empty directory</div>
      <% } else { %>
        <% files.forEach(function(file) { %>
          <a href="<%= buildFilePageUrl(file.file_path) %>" class="term-file">
            <div class="term-file-name"><%= file.file_name %></div>
            <% if (file.description) { %><div class="term-file-desc">// <%= file.description %></div><% } %>
            <div class="term-file-meta">
              <span class="size"><%= formatFileSize(file.file_size) %></span>
              <span class="term-sep">|</span>
              <span class="count"><%= formatNumber(file.download_count) %> dl</span>
              <% if (file.last_download_at) { %>
                <span class="term-sep">|</span>
                <span>last: <%= formatDate(file.last_download_at) %></span>
              <% } %>
              <% if (file.sha256) { %>
                <span class="term-sep">|</span>
                <span class="term-sha"><%= file.sha256.substring(0, 16) %></span>
              <% } %>
            </div>
          </a>
        <% }); %>
      <% } %>
    </main>
  </div>
</div>
<%- include('../../partials/footer') %>
