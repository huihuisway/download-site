<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="page-wrap">
  <header class="term-header">
    <div class="term-header-inner">
      <div class="term-logo"><span class="prompt">$</span> <span class="path">~/downloads</span></div>
      <div class="term-stats"><span class="ok">●</span> <%= totalFiles %> files · <%= formatNumber(totalDownloads) %> downloads</div>
    </div>
  </header>

  <div class="term-layout">
    <aside class="term-sidebar">
      <a href="/" class="term-nav-item active">all <span class="term-nav-count">(<%= totalFiles %>)</span></a>
      <a href="/admin" class="term-nav-item" style="margin-top:var(--space-4);border-top:1px solid var(--border);padding-top:var(--space-2);">sudo admin</a>
    </aside>

    <main class="term-main">
      <% if (directories.length === 0) { %>
        <div class="term-empty">// empty directory</div>
      <% } else { %>
        <% directories.forEach(function(dir) { %>
          <a href="/category/<%= dir.path %>" class="term-file term-folder-link">
            <div class="term-file-name"><span class="term-folder-icon" aria-hidden="true"></span><span><%= dir.name %></span></div>
            <% if (dir.isEmpty) { %><div class="term-file-desc">// empty</div><% } %>
          </a>
        <% }); %>
      <% } %>
    </main>
  </div>
</div>
<%- include('../../partials/footer') %>
