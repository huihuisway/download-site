<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Not Found</title>
  <link rel="stylesheet" href="/css/themes/terminal.css">
</head>
<body>

  <div class="term-error">
    <div>
      <div style="font-size: 4rem; font-weight: 700; color: var(--red); opacity: 0.3; margin-bottom: 8px;">404</div>
      <div style="color: var(--red); font-size: 12px; margin-bottom: 12px;">// not found</div>
      <h2 style="font-size: 14px;">URL not found on this server.</h2>
      <p style="margin-top: 20px;"><a href="/" class="term-link">$ cd ~/downloads</a></p>
    </div>
  </div>

</body>
</html>
