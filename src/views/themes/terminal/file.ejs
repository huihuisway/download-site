<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="page-wrap">
  <header class="term-header">
    <div class="term-header-inner">
      <div class="term-logo"><span class="prompt">$</span> <span class="path">~/downloads/<%= publicFilePath %></span></div>
      <div class="term-stats"><%= formatNumber(file.download_count) %> 次下载</div>
    </div>
  </header>

  <div class="term-layout">
    <aside class="term-sidebar">
      <% if (parentHref) { %>
        <a href="<%= parentHref %>" class="term-nav-item term-nav-command">$ cd ..</a>
      <% } else { %>
        <a href="/" class="term-nav-item term-nav-command">$ cd /</a>
      <% } %>
    </aside>

    <main class="term-main">
      <div class="term-section">
        <div class="term-section-header">
          <span class="label">$ stat <%= file.file_name %></span>
        </div>
        <div class="term-file" style="cursor: default;">
          <div class="term-file-name"><%= file.file_name %></div>
          <% if (file.description) { %><div class="term-file-desc">// <%= file.description %></div><% } %>
          <div class="term-file-meta" style="display: grid; gap: 8px;">
            <span>路径: <code><%= publicFilePath %></code></span>
            <span>大小: <%= formatFileSize(file.file_size) %></span>
            <span>下载: <%= formatNumber(file.download_count) %> 次</span>
            <% if (file.last_download_at) { %><span>最近下载: <%= formatDate(file.last_download_at) %></span><% } %>
            <% if (file.sha256) { %><span>sha256: <span class="term-sha"><%= file.sha256 %></span></span><% } %>
          </div>
        </div>
      </div>

      <a href="<%= downloadUrl %>" class="term-file">
        <div class="term-file-name">./download</div>
        <div class="term-file-desc">// 开始下载附件</div>
      </a>
    </main>
  </div>
</div>
<%- include('../../partials/footer') %>
