<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="cl-header">
  <div class="page-wrap">
    <div class="cl-header-inner">
      <span class="cl-site-name"><%= siteInfo.site_name %></span>
      <span class="cl-stats"><%= stats.file_count %> 个文件 · <%= formatFileSize(stats.total_size) %></span>
    </div>
  </div>
</div>
<div class="page-wrap">
  <div class="cl-breadcrumb">
    <a href="/">首页</a>
    <% if (breadcrumbs.length > 0) { %>
      <% breadcrumbs.forEach(function(crumb, i) { %>
        <span> / </span>
        <% if (i === breadcrumbs.length - 1) { %>
          <span><%= crumb.name %></span>
        <% } else { %>
          <a href="<%= buildCategoryHref(crumb.path) %>"><%= crumb.name %></a>
        <% } %>
      <% }); %>
    <% } %>
  </div>
</div>
<div class="cl-content page-wrap">
  <% if (parentPath) { %>
    <div class="cl-category-parent">
      <a href="<%= buildCategoryHref(parentPath) %>">← 返回上一级</a>
    </div>
  <% } %>

  <h2 class="cl-category-title"><%= currentPath === 'root' ? '根目录' : currentPath %></h2>

  <% if (directories.length > 0) { %>
    <div class="cl-card cl-category-card">
      <table class="cl-table">
        <tbody>
          <% directories.forEach(function(dir) { %>
            <tr>
              <td>
                <div class="cl-file-name-cell">
                  <span class="cl-file-icon cl-icon-folder" aria-hidden="true"></span>
                  <div>
                    <div class="cl-file-name"><a href="<%= buildCategoryHref(dir.path) %>" class="cl-row-link"><%= dir.name %></a></div>
                    <% if (dir.isEmpty) { %><div class="cl-file-desc cl-empty-label">(空)</div><% } %>
                  </div>
                </div>
              </td>
              <td class="cl-muted cl-action-cell"><a href="<%= buildCategoryHref(dir.path) %>" class="cl-dl-btn">进入</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <% if (isEmpty) { %>
    <div class="cl-empty">此目录为空</div>
  <% } else if (files.length === 0) { %>
    <div class="cl-empty">暂无文件</div>
  <% } else { %>
    <div class="cl-card">
      <table class="cl-table">
        <thead><tr><th>文件名</th><th class="cl-size-col">大小</th><th class="cl-download-col">下载</th><th class="cl-action-col">操作</th></tr></thead>
        <tbody>
          <% files.forEach(function(file) { %>
            <tr>
              <td>
                <div class="cl-file-name-cell">
                  <span class="cl-file-icon cl-icon-<%= getFileIconClass(file.file_name) %>"><%= getFileExt(file.file_name) %></span>
                  <div>
                    <div class="cl-file-name"><a href="<%= buildFilePageUrl(file.file_path) %>" class="cl-row-link"><%= file.file_name %></a></div>
                    <% if (file.description) { %><div class="cl-file-desc"><%= file.description %></div><% } %>
                  </div>
                </div>
              </td>
              <td class="cl-muted"><%= formatFileSize(file.file_size) %></td>
              <td class="cl-muted"><%= formatNumber(file.download_count) %></td>
              <td><a href="<%= buildFilePageUrl(file.file_path) %>" class="cl-dl-btn">查看</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../../partials/footer') %>
