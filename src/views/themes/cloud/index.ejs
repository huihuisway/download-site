<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="cl-header">
  <div class="page-wrap">
    <div class="cl-header-inner">
      <span class="cl-site-name"><%= siteInfo.site_name %></span>
      <span class="cl-stats"><%= totalFiles %> 个文件 · <%= formatNumber(totalDownloads) %> 次下载</span>
    </div>
  </div>
</div>
<div class="cl-content page-wrap">
  <% if (directories.length === 0) { %>
    <div class="cl-empty"><p>暂无文件</p><a href="/admin" class="cl-dl-btn">进入管理后台上传</a></div>
  <% } else { %>
    <div class="cl-card">
      <table class="cl-table">
        <thead><tr><th>文件夹</th><th style="width:100px">操作</th></tr></thead>
        <tbody>
          <% directories.forEach(function(dir) { %>
            <tr>
              <td>
                <div class="cl-file-name-cell">
                  <span class="cl-file-icon cl-icon-folder" aria-hidden="true"></span>
                  <div>
                    <div class="cl-file-name"><a href="<%= buildCategoryHref(dir.path) %>" style="color: inherit; text-decoration: none;"><%= dir.name %></a></div>
                    <% if (dir.isEmpty) { %><div class="cl-file-desc" style="color: var(--text-muted);">(空)</div><% } %>
                  </div>
                </div>
              </td>
              <td><a href="<%= buildCategoryHref(dir.path) %>" class="cl-dl-btn">进入</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../../partials/footer') %>
