<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/themes/mirror.css">
</head>
<body>

  <header class="mirror-header">
    <div class="mirror-header-inner">
      <span class="mirror-title"><a href="/">Index of /<%= siteInfo.site_name %></a></span>
      <span class="mirror-nav"><%= formatNumber(totalFiles) %> files · <a href="/admin">admin</a></span>
    </div>
  </header>

  <div class="mirror-content">
    <% if (categories.length === 0) { %>
      <div class="mirror-empty">No files available.</div>
    <% } else { %>
      <% for (const category of categories) { %>
        <% const files = filesByCategory[category] || []; %>
        <% if (files.length === 0) continue; %>

        <div class="mirror-section"><a href="/category/<%= encodeURIComponent(category) %>"><%= category %>/</a></div>
        <table class="mirror-table">
          <thead>
            <tr>
              <th style="width: 50%;">Name</th>
              <th style="text-align: right;">Size</th>
              <th style="text-align: right;">Downloads</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <% for (const file of files) { %>
            <tr>
              <td class="mirror-filename"><a href="/download/<%= file.id %>"><%= file.file_name %></a></td>
              <td class="mirror-size"><%= formatFileSize(file.file_size) %></td>
              <td class="mirror-size"><%= formatNumber(file.download_count) %></td>
              <td class="mirror-desc"><%= file.description || '' %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    <% } %>
  </div>

  <footer class="mirror-footer">
    <span><%= siteInfo.footer_text %></span>
    <% if (siteInfo.footer_links && siteInfo.footer_links.length) { %>
      <span>
        <% for (const link of siteInfo.footer_links) { %>
          <a href="<%= link.url %>"><%= link.label %></a>
        <% } %>
      </span>
    <% } %>
  </footer>

</body>
</html>
