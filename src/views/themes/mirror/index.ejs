<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="mi-header">
  <div class="page-wrap">
    <div class="mi-header-inner">
      <a href="/" class="mi-title"><%= siteInfo.site_name %></a>
      <a href="/admin" class="mi-nav-link">管理后台</a>
    </div>
  </div>
</div>
<div class="mi-content page-wrap">
  <div class="mi-stats"><strong><%= totalFiles %></strong> 个文件 · <strong><%= formatNumber(totalDownloads) %></strong> 次下载</div>
  <% if (categories.length === 0) { %>
    <div class="mi-empty">暂无文件</div>
  <% } else { %>
    <% categories.forEach(function(cat) { %>
      <% var files = filesByCategory[cat] || []; %>
      <% if (files.length > 0) { %>
        <h2 class="mi-section"><%= cat %>/</h2>
        <table class="mi-table">
          <tbody>
            <% files.forEach(function(file) { %>
              <tr>
                <td style="width:40%"><a href="/download/<%= file.id %>" class="mi-filename"><%= file.file_name %></a></td>
                <td class="mi-size mi-right" style="width:15%"><%= formatFileSize(file.file_size) %></td>
                <td class="mi-desc"><%= file.description || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    <% }); %>
  <% } %>
</div>
<%- include('../../partials/footer') %>
