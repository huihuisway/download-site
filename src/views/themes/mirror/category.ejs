<%- include('../../partials/head', { title, currentTheme, siteInfo }) %>
<div class="mi-header">
  <div class="page-wrap">
    <div class="mi-header-inner">
      <a href="/" class="mi-title"><%= siteInfo.site_name %></a>
      <a href="/admin" class="mi-nav-link">管理后台</a>
    </div>
  </div>
</div>
<div class="page-wrap">
  <div class="mi-breadcrumb">
    <a href="/">downloads</a>
    <% if (breadcrumbs.length > 0) { %>
      <% breadcrumbs.forEach(function(crumb) { %>
        <span> / </span>
        <a href="<%= buildCategoryHref(crumb.path) %>"><%= crumb.name %></a>
      <% }); %>
    <% } %>
  </div>
</div>
<div class="mi-content page-wrap">
  <div class="mi-stats">
    <strong><%= stats.file_count %></strong> 个文件 ·
    <strong><%= formatNumber(stats.total_downloads) %></strong> 次下载 ·
    <strong><%= formatFileSize(stats.total_size) %></strong>
  </div>

  <% if (parentPath) { %>
    <div style="margin-bottom: 0.75rem;">
      <a href="<%= buildCategoryHref(parentPath) %>">← 返回上一级</a>
    </div>
  <% } %>

  <h2 style="margin-bottom: 1rem;"><%= currentPath === 'root' ? '根目录' : currentPath %></h2>

  <% if (directories.length > 0) { %>
    <div class="mi-cat-list" style="margin-bottom: 1rem;">
      <% directories.forEach(function(dir) { %>
        <span class="mi-cat-item"><a href="<%= buildCategoryHref(dir.path) %>"><%= dir.name %></a> <% if (dir.isEmpty) { %><span class="mi-count">(空)</span><% } %></span>
      <% }); %>
    </div>
  <% } %>

  <% if (isEmpty) { %>
    <div class="mi-empty">此目录为空</div>
  <% } else if (files.length === 0) { %>
    <div class="mi-empty">暂无文件</div>
  <% } else { %>
    <table class="mi-table">
      <thead><tr><th>文件名</th><th class="mi-right">大小</th><th class="mi-right">下载次数</th><th>描述</th></tr></thead>
      <tbody>
        <% files.forEach(function(file) { %>
          <tr>
            <td><a href="<%= buildFilePageUrl(file.file_path) %>" class="mi-filename"><%= file.file_name %></a></td>
            <td class="mi-size mi-right"><%= formatFileSize(file.file_size) %></td>
            <td class="mi-mono mi-right"><%= formatNumber(file.download_count) %></td>
            <td class="mi-desc"><%= file.description || '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
<%- include('../../partials/footer') %>
