{
  "name": "download-site",
  "version": "1.0.0",
  "description": "轻量级极简下载站 - Debian 镜像站风格",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "build:admin": "cd admin && npm install && npm run build",
    "build": "npm run build:admin",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "download",
    "file-server",
    "debian-style"
  ],
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "sanitize-filename": "^1.6.3",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.8.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
