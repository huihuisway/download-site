{
  "name": "download-site",
  "version": "1.0.0",
  "description": "轻量级极简下载站 - Debian 镜像站风格",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "build:admin": "cd admin && npm install && npm run build",
    "build": "npm run build:admin",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": ["download", "file-server", "debian-style"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "ejs": "^3.1.10",
    "express-session": "^1.18.1",
    "session-file-store": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-filename": "^1.6.3",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
